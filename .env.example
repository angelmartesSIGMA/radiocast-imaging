# ── Supabase (self-hosted) ─────────────────────────────────────────────
# Public URL of your Supabase gateway (Kong). Browsers upload/download audio
# through signed URLs on this host, so it must be reachable over HTTPS.
SUPABASE_URL=https://supabase.example.com
# SERVICE_ROLE_KEY from your self-hosted Supabase .env. Server-only — never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site-wide Basic Auth (testing gate, see proxy.ts) ──────────────────
BASIC_AUTH_USER=radiocast
BASIC_AUTH_PASSWORD=change-me

# ── Admin dashboard (/admin) ───────────────────────────────────────────
ADMIN_PASSWORD=change-me-too
# 32+ random characters; signs the admin session cookie.
ADMIN_SESSION_SECRET=
